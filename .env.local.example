# Copy to .env.local (gitignored). Every value is optional: the app runs on mock data without them.

# Claude API, used server-side by /api/plan and /api/persona (Samuel).
ANTHROPIC_API_KEY=
# Model id; empty means the client default.
ANTHROPIC_MODEL=

# Google Maps Platform browser key with Map Tiles API enabled (Photorealistic 3D + 2D tiles).
# It ships to the browser, so restrict it by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base URL of the Python simulation service (sim/). When set, /api/simulate proxies to ${SIM_URL}/simulate.
SIM_URL=
# e.g. SIM_URL=http://localhost:8000  (see sim/README.md)
